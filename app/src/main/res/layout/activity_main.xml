<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Title of the App -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Screen Translation Application"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/language_card" />

    <!-- Language Selection Section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/language_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp">

            <!-- Spinner for Source Language -->
            <Spinner
                android:id="@+id/source_language_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="?attr/colorPrimary" />

            <!-- Button to swap the languages -->
            <ImageButton
                android:id="@+id/button_swap_languages"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:backgroundTint="?attr/colorPrimary"
                android:src="@drawable/ic_swap"
                android:contentDescription="Swap Languages"
                app:tint="@color/white" />

            <!-- Spinner for Target Language -->
            <Spinner
                android:id="@+id/target_language_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="8dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Text Input Section -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập văn bản để dịch"
        android:layout_marginTop="16dp"

        app:startIconDrawable="@drawable/ic_speaker"
        app:startIconTint="?attr/colorPrimary"
        app:startIconContentDescription="Speak Input"

        app:endIconDrawable="@drawable/ic_copy"
        app:endIconTint="?attr/colorPrimary"
        app:endIconContentDescription="Copy Input Text"
        app:endIconMode="custom"

        app:layout_constraintTop_toBottomOf="@id/language_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:padding="16dp" >
        </com.google.android.material.textfield.TextInputEditText>

    </com.google.android.material.textfield.TextInputLayout>


    <!-- Translation Result Section -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_output_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:hint="Kết quả dịch sẽ hiển thị ở đây"

        app:startIconDrawable="@drawable/ic_speaker"
        app:startIconTint="?attr/colorPrimary"
        app:startIconContentDescription="Speak Input"

        app:endIconDrawable="@drawable/ic_copy"
        app:endIconTint="?attr/colorPrimary"
        app:endIconContentDescription="Copy Input Text"
        app:endIconMode="custom"

        app:layout_constraintTop_toBottomOf="@id/text_input_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_translationResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:padding="16dp"
            android:focusable="false" />
    </com.google.android.material.textfield.TextInputLayout>


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/text_output_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/button_voice_translation"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice Translation"
            android:src="@drawable/ic_microphone"
            app:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/button_upload_image"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Upload Image"
            android:src="@drawable/ic_upload"
            app:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/button_take_picture"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Take Picture"
            android:src="@drawable/ic_camera"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Floating Window Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_start_floating_window"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bật Cửa Sổ Nổi"
        android:padding="12dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/linearLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
